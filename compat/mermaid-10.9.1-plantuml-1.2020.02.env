# Legacy compatibility profile for the previous Ubuntu-package-based paper Docker image.
#
# This profile documents what renders with Mermaid CLI 10.9.1 and the
# Ubuntu 24.04 PlantUML package. It is intentionally narrower than the
# my-slides-vault reference profile.

DIAVISUALS_COMPAT_ID=mermaid-10.9.1-plantuml-1.2020.02
DIAVISUALS_FAMILY=benizar
DIAVISUALS_PROFILE_STATUS=legacy-record-only

MERMAID_CLI_VERSION=10.9.1
PLANTUML_VERSION=1.2020.02

MERMAID_TYPES="class er flowchart gantt gitgraph journey pie quadrantchart sankey sequence state timeline"
MERMAID_UNSUPPORTED_TYPES="block kanban treemap"

# PlantUML 1.2020.02 renders the core diagram set used by the older paper
# toolchain. Newer starts such as @startfiles, @startjson and @startyaml remain
# source examples, but are not guaranteed by this legacy profile.
PLANTUML_TYPES="activity class component deployment mindmap object salt sequence state usecase wbs"
PLANTUML_UNSUPPORTED_TYPES="files gantt json yaml"
