# Compatibility profile for the engine pair currently exercised by unaltrepaper.
#
# Mermaid CLI is pinned by npm package version. PlantUML 1.2020.02 is the
# Ubuntu 24.04 package used by the current Docker-based paper build.

DIAVISUALS_COMPAT_ID=mermaid-10.9.1-plantuml-1.2020.02
DIAVISUALS_FAMILY=benizar
DIAVISUALS_RENDER_IMAGE=unaltrepaper/texlive:latest

MERMAID_CLI_VERSION=10.9.1
PLANTUML_VERSION=1.2020.02

MERMAID_TYPES="class er flowchart gantt gitgraph journey pie quadrantchart sankey sequence state timeline"
MERMAID_UNSUPPORTED_TYPES="block kanban treemap"

# PlantUML 1.2020.02 renders the core diagram set used by the current paper
# toolchain. Newer starts such as @startjson, @startyaml and @startfiles are
# kept as source examples, but are not part of this profile's rendered gallery.
PLANTUML_TYPES="activity class component deployment mindmap object salt sequence state usecase wbs"
PLANTUML_UNSUPPORTED_TYPES="files gantt json yaml"
