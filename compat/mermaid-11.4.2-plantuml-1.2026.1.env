# Compatibility record for the v0.2.0 renderer.
#
# my-slides-vault uses Mermaid CLI 11.4.2 and a pinned PlantUML 1.2026.1 JAR,
# which cover newer diagram starts such as Mermaid kanban/block/treemap and
# PlantUML @startfiles/@startjson/@startyaml.

DIAVISUALS_COMPAT_ID=mermaid-11.4.2-plantuml-1.2026.1
DIAVISUALS_FAMILY=benizar
DIAVISUALS_PROFILE_STATUS=legacy-record-only
MERMAID_CLI_VERSION=11.4.2
PLANTUML_VERSION=1.2026.1

MERMAID_TYPES="block class er flowchart gantt gitgraph journey kanban pie quadrantchart sankey sequence state timeline treemap"
MERMAID_UNSUPPORTED_TYPES=""

PLANTUML_TYPES="activity class component deployment files gantt json mindmap object salt sequence state usecase wbs yaml"
PLANTUML_UNSUPPORTED_TYPES=""
