#!/usr/bin/env bash
set -euo pipefail

FACTORY_ROOT="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
CLI="${FACTORY_ROOT}/.venv/bin/diavisuals"

case "${1:-}" in
  build|init|check|tests|smoke|down|update|release-status|install-check|factory-check|install-codex-mcp|serve|client-config|manifest|styles|audit|project-check|render|render-text|export-bundle)
    OPERATION="$1"
    PROJECT_ROOT=""
    shift
    ;;
  *)
    PROJECT_ROOT="${1:?consumer project root is required}"
    OPERATION="${2:?factory operation is required}"
    shift 2
    ;;
esac

case "${OPERATION}" in
  init|down|install-codex-mcp|project-check|render|render-text|export-bundle)
    if [[ -z "${PROJECT_ROOT}" ]]; then
      PROJECT_ROOT="${1:?consumer project root is required}"
      shift
    fi
    ;;
  serve)
    if [[ -z "${PROJECT_ROOT}" ]]; then
      PROJECT_ROOT="${1:-${MCP_CONSUMER_WORKSPACE:-}}"
      [[ -n "${PROJECT_ROOT}" ]] || {
        printf 'Consumer project root is required\n' >&2
        exit 2
      }
      if [[ $# -gt 0 ]]; then
        shift
      fi
    fi
    ;;
  *)
    if [[ -z "${PROJECT_ROOT}" ]]; then
      PROJECT_ROOT="${FACTORY_ROOT}"
    fi
    ;;
esac

bootstrap() {
  uv --directory "${FACTORY_ROOT}" sync --locked --extra dev --extra mcp --quiet
}

require_prepared() {
  [[ -x "$CLI" ]] || {
    printf 'Prepared diavisuals CLI is missing; run make mcp-build explicitly first\n' >&2
    exit 2
  }
}

case "${OPERATION}" in
  build)
    bootstrap
    "${CLI}" install-check --command "${CLI}" >/dev/null
    exec "${CLI}" ensure-renderer "$@"
    ;;
  init)
    bootstrap
    exec "${CLI}" --project "${PROJECT_ROOT}" init "$@"
    ;;
  check)
    require_prepared
    exec "${CLI}" lifecycle-check --command "${CLI}" "$@"
    ;;
  tests)
    bootstrap
    exec make --no-print-directory -C "${FACTORY_ROOT}" tests
    ;;
  smoke)
    bootstrap
    exec make --no-print-directory -C "${FACTORY_ROOT}" mcp-smoke
    ;;
  down)
    require_prepared
    exec "${CLI}" --project "${PROJECT_ROOT}" down "$@"
    ;;
  update)
    bootstrap
    exec "${CLI}" --project "${PROJECT_ROOT}" update "$@"
    ;;
  release-status)
    require_prepared
    exec "${CLI}" --project "${PROJECT_ROOT}" release-status "$@"
    ;;
  install-check)
    require_prepared
    exec "${CLI}" --project "${PROJECT_ROOT}" install-check --command "${CLI}" "$@"
    ;;
  factory-check)
    require_prepared
    exec "${CLI}" --project "${PROJECT_ROOT}" factory-check "$@"
    ;;
  install-codex-mcp)
    require_prepared
    exec "${CLI}" --project "${PROJECT_ROOT}" install-codex-mcp --project-root "${PROJECT_ROOT}" --command "${CLI}" "$@"
    ;;
  serve)
    require_prepared
    exec "${CLI}" --project "${PROJECT_ROOT}" mcp serve
    ;;
  client-config)
    require_prepared
    exec "${CLI}" --project "${PROJECT_ROOT}" mcp client-config --command "${CLI}" "$@"
    ;;
  manifest)
    require_prepared
    exec "${CLI}" --project "${PROJECT_ROOT}" factory-manifest "$@"
    ;;
  styles)
    require_prepared
    exec "${CLI}" --project "${PROJECT_ROOT}" style-inventory "$@"
    ;;
  audit)
    require_prepared
    exec "${CLI}" --project "${PROJECT_ROOT}" style-audit "$@"
    ;;
  project-check)
    require_prepared
    exec "${CLI}" --project "${PROJECT_ROOT}" project-check "$@"
    ;;
  render)
    require_prepared
    exec "${CLI}" --project "${PROJECT_ROOT}" render-diagram "$@"
    ;;
  render-text)
    require_prepared
    exec "${CLI}" --project "${PROJECT_ROOT}" render-diagram-text "$@"
    ;;
  export-bundle)
    require_prepared
    exec "${CLI}" --project "${PROJECT_ROOT}" export-diagram-bundle "$@"
    ;;
  *)
    printf 'Unknown factory operation: %s\n' "${OPERATION}" >&2
    exit 2
    ;;
esac
